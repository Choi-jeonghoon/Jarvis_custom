# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env
# .env 는 .gitignore 에 들어 있어서 git 에 올라가지 않습니다.

# 필수: 자비스 API 서버 키. 아래 명령으로 생성할 수 있습니다.
#   python3 -c "import secrets; print('oj_sk_' + secrets.token_urlsafe(32))"
OPENJARVIS_API_KEY=

# 선택: Claude 연결용
ANTHROPIC_API_KEY=

# 선택: OpenAI 연결용
OPENAI_API_KEY=

# 선택: 유료 ElevenLabs 음성. 기본 목소리는 무료 Edge 음성(InJoon)이라 비워 둬도 됩니다.
# 쓰려면 ~/.openjarvis/config.toml 의 [speech] 를 tts_backend = "elevenlabs" 로 바꾸세요.
ELEVENLABS_API_KEY=
